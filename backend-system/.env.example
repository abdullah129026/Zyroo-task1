# Server configuration
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins, or * to allow all
CORS_ORIGIN=*

# Database
# Replace with your own MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority

# JWT Configuration
# Use a strong secret key (minimum 32 characters recommended for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Stripe Billing (Week 6 — subscription & usage quotas)
# Use TEST keys from https://dashboard.stripe.com/test/apikeys while developing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the Pro and Team plans (create Products/Prices in the Stripe dashboard)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# Frontend URL used for Stripe Checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000