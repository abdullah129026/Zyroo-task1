# Server configuration
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins, or * to allow all
CORS_ORIGIN=*

# Database
# Replace with your own MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority

# JWT Configuration
# Use a strong secret key (minimum 32 characters recommended for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Stripe Billing (Week 6 — subscription & usage quotas)
# Use TEST keys from https://dashboard.stripe.com/test/apikeys while developing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the Pro and Team plans (create Products/Prices in the Stripe dashboard)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# Frontend URL used for Stripe Checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000

# Google Gemini (embeddings + chat) — required for document processing and chat
GOOGLE_GEMINI_API_KEY=<redacted>
# Optional model overrides
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
# Optional cap on retrieved-context tokens per chat prompt
RAG_MAX_CONTEXT_TOKENS=6000

# Admin bootstrap (Weeks 7-8): comma-separated emails promoted to the
# admin role on register/login. Use your own platform-owner email.
ADMIN_EMAILS=you@example.com

# Uploads (Weeks 7-8): destination folder (created automatically) and
# per-file size cap in bytes (default 25 MB)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# Input length caps (Weeks 7-8 hardening)
CHAT_MAX_MESSAGE_CHARS=4000
SEARCH_MAX_QUERY_CHARS=1000

# Set to "true" ONLY for the automated test suite; never in production
DISABLE_RATE_LIMITS=false